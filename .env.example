# PrivateFlix - Environment Configuration
# Copy this file to .env and fill in the values
# NEVER commit .env files with real credentials

# ─── Database ───────────────────────────────────────────────
DATABASE_URL="postgresql://privateflix:devpass_change_in_production@localhost:5432/privateflix?schema=public"

# ─── Object Storage (MinIO / S3-compatible) ─────────────────
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin_change_in_production"
S3_BUCKET="privateflix-media"
S3_REGION="us-east-1"

# ─── Redis (for BullMQ job queue) ───────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Session & Security ────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET="CHANGE_THIS_TO_A_RANDOM_64_BYTE_HEX_STRING"
SESSION_IDLE_TIMEOUT="86400"
SESSION_ABSOLUTE_TIMEOUT="604800"

# ─── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT_WINDOW="900"
RATE_LIMIT_MAX="5"

# ─── Upload Limits ──────────────────────────────────────────
MAX_UPLOAD_SIZE="10737418240"
ALLOWED_VIDEO_TYPES="mp4,webm,mkv,mov,avi"
ALLOWED_IMAGE_TYPES="jpg,jpeg,png,webp,gif,heic"

# ─── Media Processing ──────────────────────────────────────
ENABLE_TRANSCODING="false"
FFMPEG_TIMEOUT="600"

# ─── Application ────────────────────────────────────────────
NODE_ENV="development"
APP_URL="http://localhost:3000"
APP_NAME="PrivateFlix"
APP_ACCENT_COLOR="#8b5cf6"
