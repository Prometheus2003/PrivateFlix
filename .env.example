# Prefer npm run env:init to generate unique LOCAL credentials.
# Placeholders only. Do not use this file directly as a working configuration.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
POSTGRES_PORT=5432
DATABASE_URL=postgresql://privateflix:REPLACE_WITH_RANDOM_HEX@127.0.0.1:5432/privateflix?schema=public
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=REPLACE_WITH_RANDOM_HEX
S3_SECRET_KEY=REPLACE_WITH_RANDOM_HEX
S3_BUCKET=privateflix-media
S3_REGION=us-east-1

# Optional Google Drive primary storage. Keep S3 for upload staging and older files.
# Run npm run drive:connect -- path/to/oauth-client.json (docs/GOOGLE_DRIVE.md).
STORAGE_PROVIDER=s3
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REFRESH_TOKEN=
# GOOGLE_DRIVE_FOLDER_ID=
REDIS_PASSWORD=REPLACE_WITH_RANDOM_HEX
REDIS_URL=redis://:REPLACE_WITH_RANDOM_HEX@127.0.0.1:6379
SESSION_SECRET=REPLACE_WITH_64_RANDOM_BYTES_AS_HEX
SESSION_IDLE_TIMEOUT=86400
SESSION_ABSOLUTE_TIMEOUT=604800
RATE_LIMIT_WINDOW=900
RATE_LIMIT_MAX=5
MAX_UPLOAD_SIZE=10737418240
ALLOWED_VIDEO_TYPES=mp4,webm,mkv,mov,avi
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp,gif,heic
ENABLE_TRANSCODING=false
# Overall processing timeout in seconds (maximum 900).
FFMPEG_TIMEOUT=600
APP_URL=http://localhost:3000
APP_NAME=PrivateFlix
APP_ACCENT_COLOR="#8b5cf6"
# NODE_ENV is managed by Next.js, not stored here.

# Required only for first-run setup; send as X-Setup-Token, remove after setup.
# Generate 32 random bytes encoded as 64 hex characters.
# SETUP_TOKEN=
